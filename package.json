{
  "name": "slopbot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "SlopBot AI — the slop engine as a service: viewers prompt an AI agent from Twitch chat, the agent codes live canvas slops that play on stream.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
